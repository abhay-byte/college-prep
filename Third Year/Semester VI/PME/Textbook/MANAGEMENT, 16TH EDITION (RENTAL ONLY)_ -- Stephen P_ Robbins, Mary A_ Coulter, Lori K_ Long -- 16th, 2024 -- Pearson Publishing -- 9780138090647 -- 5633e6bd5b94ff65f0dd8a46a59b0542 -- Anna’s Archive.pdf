   <dc:creator>
    <rdf:Seq>
     <rdf:li>Jordan Strauss</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">IMAGE DISTRIBUTED FOR HUGGIES - From left, Myeisha Gamino, Director of Corporate Affairs and Government Relations at Ralphs, John Piersma, GM/HBC Merchandiser at Ralphs, Joanne Goldblum, CEO at the National Diaper Bank Network and Cameron Kinslow, LA Operations and Program Manager at GOOD+ Foundation pose in front of a portion of the 250,000 Huggies diapers donated to GOOD+ Foundation, which will benefit Los Angeles families in need, including those impacted by the wildfires, on behalf of Ralphs, Huggies and the National Diaper Bank Network at GOOD+ Foundation on Monday, Dec. 11, 2017 in Los Angeles. The donation event celebrates the larger program that, for every package of Huggies diapers purchased in-store at Kroger (the parent company of Ralphs) stores from November 8-December 5, Kroger and Huggies donated a day's worth of diapers‚Äîup to 1 million‚Äîto the National Diaper Bank Network. (Jordan Strauss/AP Images for Huggies)</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">AP IMAGES</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Huggies and Ralphs Donation Event at GOOD+ Foundation with the National Diaper Bank Network</rdf:li>
    </rdf:Alt>
   </dc:title>
